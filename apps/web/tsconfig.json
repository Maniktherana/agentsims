{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			// fumadocs-mdx resolves its own fumadocs-core copy. One copy of the
			// source types lets `loader()` infer the page data.
			"fumadocs-core/source": ["./node_modules/fumadocs-core/dist/source/index.d.ts"]
		},
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
