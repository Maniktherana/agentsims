class Agentsims < Formula
  desc "Local multi-device simulator workspace"
  homepage "__AGENTSIMS_HOMEPAGE__"
  version "__AGENTSIMS_VERSION__"
  license "Apache-2.0"

  on_macos do
    on_arm do
      depends_on arch: :arm64
      url "__AGENTSIMS_DARWIN_ARM64_URL__"
      sha256 "__AGENTSIMS_DARWIN_ARM64_SHA256__"
    end
    on_intel do
      depends_on arch: :x86_64
      url "__AGENTSIMS_DARWIN_X64_URL__"
      sha256 "__AGENTSIMS_DARWIN_X64_SHA256__"
    end
  end

  on_linux do
    depends_on arch: :x86_64
    on_intel do
      url "__AGENTSIMS_LINUX_X64_URL__"
      sha256 "__AGENTSIMS_LINUX_X64_SHA256__"
    end
  end

  def install
    if OS.mac? && Hardware::CPU.arm?
      required = __AGENTSIMS_DARWIN_ARM64_FILES__
    elsif OS.mac? && Hardware::CPU.intel?
      required = __AGENTSIMS_DARWIN_X64_FILES__
    elsif OS.linux? && Hardware::CPU.intel?
      required = __AGENTSIMS_LINUX_X64_FILES__
    else
      odie "Agentsims supports macOS arm64 and x86_64, or Linux x86_64."
    end
    required.each do |file|
      odie "The release asset is missing: #{file}" unless File.file?(file) && File.size?(file)
    end
    odie "The runtime is not executable." unless File.executable?("dist/agentsims")
    libexec.install "dist", "LICENSE"
    bin.write_exec_script libexec/"dist/agentsims"
  end

  test do
    assert_equal version.to_s, shell_output("\"#{bin}/agentsims\" --version").strip
  end
end
