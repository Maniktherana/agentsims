{
  "name": "agentsims",
  "version": "0.1.0",
  "description": "Local multi-device simulator workspace for React Native and Expo development",
  "keywords": [
    "accessibility",
    "android-emulator",
    "developer-tools",
    "expo",
    "ios-simulator",
    "react-native"
  ],
  "homepage": "https://github.com/Maniktherana/agentsims#readme",
  "bugs": {
    "url": "https://github.com/Maniktherana/agentsims/issues"
  },
  "license": "Apache-2.0",
  "author": "Agentsims contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maniktherana/agentsims.git",
    "directory": "packages/agentsims"
  },
  "bin": {
    "agentsims": "dist/agentsims.js"
  },
  "files": [
    "LICENSE",
    "dist/agentsims.js",
    "dist/middleware.js",
    "dist/middleware.cjs",
    "dist/state.js",
    "dist/state.cjs",
    "dist/metro.js",
    "dist/metro.cjs",
    "dist/babel-plugin.cjs",
    "dist/types/**",
    "dist/preview/**",
    "dist/simcam/libSimCameraInjector.dylib",
    "dist/simcam/agentsims-camera-helper",
    "dist/simax/agentsims-ax-settings",
    "dist/android/agentsims-ax-server.jar",
    "dist/native/agentsims-native.node",
    "dist/native/agentsims-android-video.node"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "type": "module",
  "exports": {
    "./middleware": {
      "types": "./dist/types/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./state": {
      "types": "./dist/types/shared/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./metro": {
      "types": "./dist/types/rn/metro.d.ts",
      "import": "./dist/metro.js",
      "require": "./dist/metro.cjs"
    },
    "./babel-plugin": {
      "types": "./dist/types/rn/babel-plugin.d.ts",
      "require": "./dist/babel-plugin.cjs",
      "default": "./dist/babel-plugin.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:android:ax": "bash android/accessibility/build.sh",
    "build:android:video": "bash android/video/build.sh",
    "start": "node dist/agentsims.js",
    "prepack": "bun run build && bun run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:dry-run": "npm pack --dry-run --json",
    "lint": "oxlint src --deny-warnings",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "smoke:android": "bun run scripts/android-live-smoke.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@fontsource/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.3.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "inspect-webkit": "^0.0.5",
    "sonner": "^2.0.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "latest",
    "@types/debug": "^4.1.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "bun-plugin-tailwind": "^0.1.2",
    "commander": "^14.0.1",
    "debug": "^4.4.3",
    "lucide-react": "^1.20.0",
    "motion": "^12.42.2",
    "node-swift": "1.5.1",
    "oxlint": "^1.74.0",
    "preact": "^10.29.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
